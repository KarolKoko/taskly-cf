POSTGRES_HOST=localhost
POSTGRES_USER=taskly
POSTGRES_PASSWORD=taskly
POSTGRES_DB=taskly
DB_PORT=5432
API_PORT=8000
WEB_PORT=8080

USE_LLM=false
# Required only when USE_LLM=true (store it as a GitHub secret, never commit it)
LLM_API_KEY=
# Optional: LLM_MODEL=gpt-4o-mini, LLM_BASE_URL=https://api.openai.com/v1, LLM_MAX_OUTPUT_TOKENS=900

# Optional local override; otherwise the URL is built from the values above.
# DATABASE_URL=postgresql://taskly:taskly@localhost:5432/taskly
